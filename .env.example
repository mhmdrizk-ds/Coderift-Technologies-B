# Copy this file to .env and fill in real values. .env is gitignored —
# never commit an API key or DB credential.

# Optional: if set, agent/sampling.py makes a live call to the Google
# Gemini API for draft_incident_summary's sampling/createMessage response.
# If unset, it falls back to a deterministic offline rule engine so the
# demo still runs end-to-end with no external dependency.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Streamable HTTP transport bind address (see mcp_server/server_http.py).
# Not required for the stdio server or for --all demo runs.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
