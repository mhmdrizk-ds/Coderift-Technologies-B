# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets — never commit an API key or DB credential
.env
.env.*
!.env.example

# The built database is generated from db/schema.sql + db/seed.sql — do not
# commit the binary artifact, only the SQL that produces it. Lives in its
# own db/data/ subdirectory so Docker can mount a named volume onto that
# whole directory instead of onto the single file (see docker-compose.yml).
db/data/coderift.db
db/data/

# Same reasoning for generated/session-local memory & RAG artifacts that
# are pure runtime state (rebuildable from source, or specific to one
# person's local session) — but NOT the eval results below, which are
# committed as required deliverables (real numbers from a real run).
rag/vector_store/chroma_db/
memory/data/*.json
memory/logs/*.json
!memory/data/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
